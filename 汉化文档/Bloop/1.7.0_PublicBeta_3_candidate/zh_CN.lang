# Option Settings
option.ALT_CLOUDS=备选云层
option.ALT_CLOUDS.comment=Toggles alternate cloud rendering.

option.APERTURE=光圈
option.APERTURE.comment=Controls camera aperture for depth of field.

option.BLOOM=泛光
option.BLOOM.comment=Toggles bloom lighting effect.

option.BOKEH_MODE=虚化类型
option.BOKEH_MODE.comment=Sets the style of bokeh blur.

option.BUMP_MULT=法线深度
option.BUMP_MULT.comment=Adjusts the strength of normal mapping.

option.CAMERA_SENSOR_SIZE_MM=传感器大小
option.CAMERA_SENSOR_SIZE_MM.comment=Sets camera sensor size (mm) for depth calculations.

option.CAUSTICS=焦散线
option.CAUSTICS.comment=Toggles underwater caustic light effects.

option.CLOUDS=云层
option.CLOUDS.comment=Toggles cloud rendering.

option.CLOUD_COVER=云层覆盖度
